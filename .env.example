# ==============================================================================
# Gamify Environment Configuration Example
# ==============================================================================

# Node Environment
NODE_ENV=production
NODE_VERSION=20


# JWT Secret for Session Cookie / Bearer Token HMAC-SHA256 Signing
# Generate a secure 32+ character random secret using: openssl rand -base64 32
JWT_SECRET=super_secret_cryptographic_key_replace_in_production

# Cloudflare D1 Database Binding ID
# Obtain via: npx wrangler d1 create gamify-prod-db
D1_DATABASE_ID=05381ba1-cc11-468f-9859-54447cdc446f

# Cloudflare CI/CD Credentials (for GitHub Actions / Remote Deployments)
# Cloudflare API Token with "Workers Scripts: Edit" and "D1: Edit" permissions
CLOUDFLARE_API_TOKEN=your-cloudflare-api-token
CLOUDFLARE_ACCOUNT_ID=your-cloudflare-account-id
